{
  "name": "terminal-simulator",
  "version": "1.0.5",
  "description": "Interactive Linux terminal simulator for the browser - use as Vanilla JS or React component",
  "type": "module",
  "main": "./dist/terminal-simulator.cjs",
  "module": "./dist/terminal-simulator.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/terminal-simulator.js",
      "require": "./dist/terminal-simulator.cjs",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "terminal",
    "simulator",
    "linux",
    "shell",
    "bash",
    "interactive",
    "react",
    "typescript",
    "component",
    "virtual-machine"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.config.ts",
    "compile": "tsc --noEmit && vite build --config vite.config.ts",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/terminal-simulator.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/terminal-simulator/issues"
  },
  "homepage": "https://github.com/yourusername/terminal-simulator#readme",
  "author": "Your Name",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}