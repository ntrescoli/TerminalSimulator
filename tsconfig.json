{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    
    /* CAMBIO AQUÍ: Permitir la salida de archivos */
    "noEmit": true, 

    /* Type Declaration Generation */
    "declaration": true,
    "declarationMap": true,
    /* CAMBIO AQUÍ: Decirle a tsc que SOLO genere los .d.ts, ya que Vite hace el resto */
    "emitDeclarationOnly": false, 
    /* CAMBIO AQUÍ: Indicar dónde debe escupir los tipos para que coincida con tu package.json */
    "outDir": "./dist", 

    /* Linting / Strict Mode */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    
    /* Paths */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"]
}